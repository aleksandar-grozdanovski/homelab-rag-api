# Homelab RAG API Environment Variables
# Copy this file to .env and update with your actual values

# LLM Provider: "ollama" (local) or "groq" (cloud)
LLM_PROVIDER=groq

# Groq API Configuration (required if using Groq provider)
GROQ_API_KEY=your-groq-api-key-here
GROQ_ENABLED=true

# Required secrets; generate independent random values (for example: openssl rand -base64 32)
POSTGRES_USER=homelab_rag
POSTGRES_PASSWORD=replace-with-a-random-password
API_KEY=replace-with-at-least-32-random-characters
DOCUMENTS_PATH=/srv/docs
