# Environment variables for local development
# Copy this to .env and add your actual values

# LLM Provider Selection
LLM_PROVIDER=ollama  # or 'groq' for cloud API

# Groq API Settings (only needed if LLM_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_ENABLED=false

# Ollama Settings
OLLAMA_BASE_URL=http://192.168.50.10:11434
OLLAMA_MODEL=llama3.2

# Database
POSTGRES_USER=homelab_rag
POSTGRES_PASSWORD=replace-with-a-random-password

# Required for every /api request (minimum 32 random characters)
API_KEY=replace-with-at-least-32-random-characters
DOCUMENTS_PATH=./documents
